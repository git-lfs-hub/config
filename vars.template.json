{
  "title": "{{org}} Hub",
  "banner": { "dark": "banner-dark.png", "light": "banner-light.png" },
  "github": {
    "home": "https://github.com/{{github.owner}}",
    "appHome": "https://{{lfs.server}}",
    "adminHome": "https://{{cloudflare.admin.workerName}}.{{cloudflare.accountSlug}}.workers.dev"
  },
  "lfs": { "server": "{{cloudflare.workerName}}.{{cloudflare.accountSlug}}.workers.dev" },
  "s3": {
    "endpoint": "https://{{cloudflare.accountId}}.r2.cloudflarestorage.com",
    "bucket": "lfs-objects",
    "backup": { "region": "", "bucket": "" }
  },
  "cloudflare": {
    "workerName": "lfs-server",
    "admin": {
      "workerName": "lfs-admin"
    },
    "kv": {
      "githubCacheId": ""
    }
  },
  "gc": {
    "autoDays": { "archive": 7, "clear": 30 },
    "confirmDays": 3,
    "retentionDays": { "live": 30, "cold": 365 },
    "coldStorage": ""
  },
  "admin": {
    "title": "{{title}} Admin",
    "slack": {
      "channel": ""
    }
  }
}
