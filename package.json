{
  "name": "@git-lfs-hub/config",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "git-lfs-hub-config": "./src/cli.ts"
  },
  "scripts": {
    "compile": "tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run compile && bun run lint && bun run format:check",
    "vitest": "bun run check && bunx --bun vitest",
    "test": "bun run vitest run",
    "test:watch": "bun run vitest watch",
    "test-coverage": "bun run test --coverage"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^26.3.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "handlebars": "^4.7.9"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260606.1",
    "@vitest/coverage-istanbul": "^4.1.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
